# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local secret rotation status (no secrets, but operational)
scripts/dev/.rotate-secret-status.json
scripts/dev/.philippe-dev-temp-password.txt
scripts/dev/*-temp-password.txt
scripts/dev/.tmp-*
scripts/dev/_audit-rls-out.json

scripts/dev/.session-validate-status.json
scripts/dev/_audit-rls-out.json
