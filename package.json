{
  "name": "catering-ai-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test Lib/auth/acceptInviteCore.test.mjs Lib/auth/appOrigin.test.mjs Lib/auth/inviteSendCore.test.mjs Lib/auth/resendInviteCore.test.mjs Lib/auth/resendInvite.test.mjs scripts/test-invite-acceptance-matrix.mjs scripts/test-resend-invite-matrix.mjs",
    "seed:dev:functional:dry": "node scripts/dev/seed-catering-functional-validation.mjs --dry-run",
    "seed:dev:functional": "node scripts/dev/seed-catering-functional-validation.mjs --apply",
    "verify:dev:functional": "node scripts/dev/verify-catering-functional-validation.mjs",
    "test:e2e:auth": "playwright test --config=playwright.config.ts && node scripts/e2e/print-auth-report.mjs",
    "test:e2e:auth:report": "node scripts/e2e/print-auth-report.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "supabase": "^2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
