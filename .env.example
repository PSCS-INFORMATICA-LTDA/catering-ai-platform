# Catering AI Platform — environment template (no secrets)
# Copy to .env.local and fill from Supabase DEV project or:
#   npx vercel env pull .env.vercel.development --environment=development --project catering-ai-platform --scope pscs-informatica-ltda-s-projects --yes
#   node scripts/sync-local-env-from-dev.mjs

# Supabase DEV (default for local + Preview)
NEXT_PUBLIC_SUPABASE_URL=https://yasprgtlqclwsjcshtls.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never expose in NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PayPal sandbox foundation — server-side only. Never set NEXT_PUBLIC_PAYPAL_CLIENT_SECRET.
# Leave unset to keep the mock adapter and public checkout off. Do not invent values.
# PAYPAL_ENABLED=false
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PUBLIC_CHECKOUT=false

# Brasinha V1B — server-side AI reasoner only. Do not expose the OpenAI key to the browser.
# Off by default so foundation tests run without a provider.
# BRASINHA_AI_ENABLED=false
# BRASINHA_AI_PROVIDER=openai
# BRASINHA_OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=
